PUBLIC WITH SHARING CLASS EMPLOYESSAGENTACTIONLEADS {
        @INVOCABLEMETHOD(
        LABEL='REATE LEADS FROM EMAIL AND REMARKS' 
        DESCRIPTION='CREATES LEADS FROM EMAIL AND REMARKS'
        CATEGORY='AGENT ACTIONS'
    )
    PUBLIC STATIC LIST<RESULT> CREATELEADS(LIST<REQUEST> REQ){
        LEAD C = NEW LEAD();
        STRING RESULTS = 'LEADS CREATED SUCCESSFULLY';
        FOR(REQUEST R:REQ)
        {
           C =  AGENTFORCEUTIL.CREATELEAD(R.EMAIL, R.REMARKS);
           RESULTS += ' '+ C.ID;
        }
        LIST<RESULT> RES = NEW LIST<RESULT>();
        RESULT R1 = NEW RESULT();
        R1.RESULT = RESULTS;
        RES.ADD(R1);
        RETURN RES;
    }

        PUBLIC CLASS REQUEST {
        @INVOCABLEVARIABLE(LABEL='EMAIL' REQUIRED=TRUE)
        PUBLIC STRING EMAIL;
        @INVOCABLEVARIABLE(LABEL='REMARKS' REQUIRED=TRUE)
        PUBLIC STRING REMARKS;
    }

    PUBLIC CLASS RESULT {
        @INVOCABLEVARIABLE(LABEL='RESULT')
        PUBLIC STRING RESULT;
    }
}